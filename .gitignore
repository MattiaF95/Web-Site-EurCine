# Global ignores for Web-Site-EurCine monorepo

# --- Eurcine (Spring Boot) ---
eurcine/HELP.md
eurcine/target/
eurcine/.mvn/wrapper/maven-wrapper.jar
!eurcine/**/src/main/**/target/
!eurcine/**/src/test/**/target/

eurcine/.apt_generated
eurcine/.classpath
eurcine/.factorypath
eurcine/.project
eurcine/.settings/
eurcine/.springBeans
eurcine/.sts4-cache

eurcine/.idea/
eurcine/*.iws
eurcine/*.iml
eurcine/*.ipr

eurcine/nbproject/private/
eurcine/nbbuild/
eurcine/dist/
eurcine/nbdist/
eurcine/.nb-gradle/
eurcine/build/
!eurcine/**/src/main/**/build/
!eurcine/**/src/test/**/build/

eurcine/.vscode/

# Sensitive config (real credentials)
eurcine/src/main/resources/application.properties
!eurcine/src/main/resources/application-example.properties

# --- Backend (Spring Boot, renamed module path) ---
backend/HELP.md
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/**/src/main/**/target/
!backend/**/src/test/**/target/

backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache

backend/.idea/
backend/*.iws
backend/*.iml
backend/*.ipr

backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/
backend/build/
!backend/**/src/main/**/build/
!backend/**/src/test/**/build/

backend/.vscode/

# Sensitive config (real credentials)
backend/src/main/resources/application.properties
backend/src/main/resources/application-prod.properties
!backend/src/main/resources/application-example.properties

# Local Maven cache in repo
eurcine/.m2/
**/.m2/

# --- Frontend (Angular) ---
frontend/dist/
frontend/tmp/
frontend/out-tsc/
